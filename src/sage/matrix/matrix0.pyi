import builtins
from typing import Any

from sage.structure.element import Matrix as _ElementMatrix

from sage.modules.free_module import FreeModule_generic
from sage.rings.integer import Integer

class Matrix(_ElementMatrix):
    def add_multiple_of_column(self, i, j, s, start_row=0, end_row=-1) -> None: ...

    def add_multiple_of_row(self, i, j, s, start_col=0, end_col=-1) -> None: ...

    def add_to_entry(self, i, j, elt) -> None: ...

    def change_ring(self, ring) -> Matrix: ...

    def commutator(self, other) -> Matrix: ...

    def dict(self, copy=True) -> builtins.dict[tuple[int, int], Any]: ...

    def dimensions(self) -> tuple[int, int]: ...

    def inverse_of_unit(self, algorithm=None) -> Matrix: ...

    def iterates(self, v, n, rows=True) -> Matrix: ...

    def kernel(self, *args, **kwds) -> FreeModule_generic: ...

    def mod(self, p) -> Matrix: ...

    def multiplicative_order(self) -> Integer: ...

    def mutate(self, k) -> None: ...

    def ncols(self) -> int: ...

    def nonpivots(self) -> tuple[int, ...]: ...

    def nonzero_positions(self, copy=True, column_order=False) -> builtins.list[tuple[int, int]]: ...

    def nonzero_positions_in_column(self, i) -> builtins.list[int]: ...

    def nonzero_positions_in_row(self, i) -> builtins.list[int]: ...

    def nullity(self) -> Integer: ...

    def permute_columns(self, permutation) -> None: ...

    def permute_rows(self, permutation) -> None: ...

    def permute_rows_and_columns(self, row_permutation, column_permutation) -> None: ...

    def pivots(self) -> tuple[int, ...]: ...

    def rank(self) -> Integer: ...

    def rescale_col(self, i, s, start_row=0) -> None: ...

    def rescale_row(self, i, s, start_col=0) -> None: ...

    def reverse_rows_and_columns(self) -> None: ...

    def set_col_to_multiple_of_col(self, i, j, s) -> None: ...

    def set_immutable(self) -> None: ...

    def set_row_to_multiple_of_row(self, i, j, s) -> None: ...

    def str(self, rep_mapping=None, zero=None, plus_one=None, minus_one=None, unicode=False, shape=None, character_art=False, left_border=None, right_border=None, top_border=None, bottom_border=None) -> builtins.str: ...

    def swap_columns(self, c1, c2) -> None: ...

    def swap_rows(self, r1, r2) -> None: ...

    def with_added_multiple_of_row(self, i, j, s, start_col=0, end_col=-1) -> Matrix: ...

    def with_permuted_rows(self, permutation) -> Matrix: ...

    def with_rescaled_row(self, i, s, start_col=0) -> Matrix: ...

    def with_row_set_to_multiple_of_row(self, i, j, s) -> Matrix: ...

    def with_swapped_columns(self, c1, c2) -> Matrix: ...

    def with_swapped_rows(self, r1, r2) -> Matrix: ...
