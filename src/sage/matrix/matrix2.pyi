import builtins
from collections.abc import Sequence
from typing import Any

from sage.modules.free_module_element import FreeModuleElement
from sage.rings.polynomial.polynomial_element import Polynomial

from sage.matrix.matrix1 import Matrix as _Matrix1
from sage.modules.free_module import FreeModule_generic
from sage.rings.integer import Integer

class Matrix(_Matrix1):
    def LU(self, pivot=None, format='plu') -> tuple[Any, Any, Any]: ...

    def QR(self, full=True) -> tuple[Any, Any]: ...

    def apply_morphism(self, phi) -> Matrix: ...

    def automorphisms_of_rows_and_columns(self) -> builtins.list[tuple[Any, Any]]: ...

    def characteristic_polynomial(self, *args, **kwds) -> Polynomial: ...

    def charpoly(self, var='x', algorithm=None) -> Polynomial: ...

    def column_space(self) -> FreeModule_generic: ...

    def denominator(self) -> Integer: ...

    def diagonal(self, offset=0) -> builtins.list[Any]: ...

    def diagonalization(self, base_field=None) -> tuple[Any, Any]: ...

    def echelon_form(self, algorithm='default', cutoff=0, **kwds) -> Matrix: ...

    def echelonize(self, algorithm='default', cutoff=0, **kwds) -> None: ...

    def eigenmatrix_left(self, other=None) -> tuple[Matrix, Matrix]: ...

    def eigenmatrix_right(self, other=None) -> tuple[Matrix, Matrix]: ...

    def eigenspaces_left(self, format='all', var='a', algebraic_multiplicity=False) -> Sequence[Any]: ...

    def eigenspaces_right(self, format='all', var='a', algebraic_multiplicity=False) -> Sequence[Any]: ...

    def eigenvalue_multiplicity(self, s) -> int: ...

    def eigenvectors_right(self, other=None, extend=True) -> builtins.list[Any]: ...

    def elementary_divisors(self, algorithm=None) -> builtins.list[Any]: ...

    def elementwise_product(self, right) -> Matrix: ...

    def get_bandwidth(self) -> Integer: ...

    def gram_schmidt(self, orthonormal=False) -> tuple[Any, Any]: ...

    def hadamard_bound(self) -> int: ...

    def hessenberg_form(self) -> Matrix: ...

    def hessenbergize(self) -> None: ...

    def indefinite_factorization(self, algorithm='symmetric', check=True) -> tuple[Any, Any]: ...

    def inverse(self) -> Matrix: ...

    def is_Z_operator_on(self, K) -> bool: ...

    def is_bistochastic(self, normalized=True) -> bool: ...

    def is_cross_positive_on(self, K) -> bool: ...

    def is_diagonalizable(self, base_field=None) -> bool: ...

    def is_lyapunov_like_on(self, K) -> bool: ...

    def is_normal(self) -> bool: ...

    def is_one(self) -> bool: ...

    def is_permutation_of(self, N, check=False) -> bool | tuple[bool, Any]: ...

    def is_positive_definite(self) -> bool: ...

    def is_positive_operator_on(self, K1, K2=None) -> bool: ...

    def is_positive_semidefinite(self) -> bool: ...

    def is_scalar(self, a=None) -> bool: ...

    def jordan_decomposition(self) -> tuple[Any, Any]: ...

    def jordan_form(self, base_ring=None, sparse=False, subdivide=True, transformation=False, eigenvalues=None, check_input=True) -> Matrix: ...

    def left_kernel(self, *args, **kwds) -> FreeModule_generic: ...

    def left_nullity(self) -> int: ...

    def maxspin(self, v) -> builtins.list[Any]: ...

    def minimal_polynomial(self, var='x', **kwds) -> Polynomial: ...

    def minors(self, k) -> builtins.list[Any]: ...

    def minpoly(self, var='x', **kwds) -> Polynomial: ...

    def permanent(self, algorithm='Ryser') -> Integer: ...

    def permanental_minor(self, k, algorithm='Ryser') -> Integer: ...

    def pivot_rows(self) -> tuple[int, ...]: ...

    def prod_of_row_sums(self, cols) -> Integer: ...

    def pseudoinverse(self, algorithm=None) -> Matrix: ...

    def randomize(self, density=1, nonzero=False, *args, **kwds) -> None: ...

    def restrict(self, V, check=True) -> Matrix: ...

    def restrict_codomain(self, V) -> Matrix: ...

    def restrict_domain(self, V) -> Matrix: ...

    def right_kernel(self, *args, **kwds) -> FreeModule_generic: ...

    def right_nullity(self) -> int: ...

    def rook_vector(self, algorithm=None, complement=False, use_complement=None) -> builtins.list[Integer]: ...

    def row_space(self, base_ring=None) -> FreeModule_generic: ...

    def rref(self, *args, **kwds) -> Matrix: ...

    def set_block(self, row, col, block) -> None: ...

    def smith_form(self, transformation=True, integral=None, exact=True) -> tuple[Any, Any, Any]: ...

    def solve_right(self, B, check=True, extend=True) -> FreeModuleElement | Matrix: ...

    def subdivide(self, row_lines=None, col_lines=None) -> None: ...

    def subdivisions(self) -> tuple[builtins.list[int], builtins.list[int]]: ...

    def subs(self, *args, **kwds) -> Matrix: ...

    def symplectic_form(self) -> tuple[Any, Any]: ...
