import builtins
from typing import Any

from sage.modules.free_module_element import FreeModuleElement

from sage.matrix.matrix0 import Matrix as _Matrix0

class Matrix(_Matrix0):
    def augment(self, right, subdivide=False) -> Matrix: ...

    def block_sum(self, other) -> Matrix: ...

    def column(self, i, from_list=False) -> FreeModuleElement: ...

    def columns(self, copy=True) -> builtins.list[FreeModuleElement]: ...

    def delete_columns(self, dcols, check=True) -> Matrix: ...

    def delete_rows(self, drows, check=True) -> Matrix: ...

    def dense_columns(self, copy=True) -> builtins.list[Any]: ...

    def dense_matrix(self) -> Matrix: ...

    def dense_rows(self, copy=True) -> builtins.list[Any]: ...

    def lift(self) -> Matrix: ...

    def lift_centered(self) -> Matrix: ...

    def matrix_from_columns(self, columns) -> Matrix: ...

    def matrix_from_rows(self, rows) -> Matrix: ...

    def matrix_from_rows_and_columns(self, rows, columns) -> Matrix: ...

    def matrix_over_field(self) -> Matrix: ...

    def new_matrix(self, nrows=None, ncols=None, entries=None, coerce=True, copy=True, sparse=None) -> Matrix: ...

    def rows(self, copy=True) -> builtins.list[FreeModuleElement]: ...

    def set_column(self, col, v) -> None: ...

    def set_row(self, row, v) -> None: ...

    def sparse_columns(self, copy=True) -> builtins.list[Any]: ...

    def sparse_matrix(self) -> Matrix: ...

    def sparse_rows(self, copy=True) -> builtins.list[Any]: ...

    def stack(self, bottom, subdivide=False) -> Matrix: ...

    def submatrix(self, row=0, col=0, nrows=-1, ncols=-1) -> Matrix: ...

    def zero_pattern_matrix(self, ring=None) -> Matrix: ...
