from __future__ import annotations

from typing import Any

from sage.structure.sage_object import SageObject

class Element(SageObject):
    def is_zero(self) -> bool: ...


class ElementWithCachedMethod(Element): ...


class ModuleElement(Element): ...


class ModuleElementWithMutability(ModuleElement): ...


class MonoidElement(Element): ...


class MultiplicativeGroupElement(MonoidElement): ...


class AdditiveGroupElement(ModuleElement): ...


class RingElement(ModuleElement): ...


class CommutativeRingElement(RingElement):
    def inverse_mod(self, I) -> CommutativeRingElement: ...


class FieldElement(CommutativeRingElement): ...


class AlgebraElement(RingElement): ...


class CommutativeAlgebraElement(CommutativeRingElement): ...


class IntegralDomainElement(CommutativeRingElement): ...


class DedekindDomainElement(IntegralDomainElement): ...


class PrincipalIdealDomainElement(DedekindDomainElement):
    def gcd(self, right) -> Element: ...

    def lcm(self, right) -> Element: ...


class EuclideanDomainElement(PrincipalIdealDomainElement): ...


class InfinityElement(RingElement): ...


class Expression(CommutativeRingElement): ...


class Matrix(ModuleElement): ...


class Vector(ModuleElementWithMutability): ...


def parent(x) -> Any: ...


def get_coercion_model() -> Any: ...


def make_element(_class, dict, parent=None) -> Element: ...


def is_Element(x: object) -> bool: ...


def is_ModuleElement(x: object) -> bool: ...


def is_AdditiveGroupElement(x: object) -> bool: ...


def is_MonoidElement(x: object) -> bool: ...


def is_MultiplicativeGroupElement(x: object) -> bool: ...


def is_RingElement(x: object) -> bool: ...


def is_CommutativeRingElement(x: object) -> bool: ...


def is_FieldElement(x: object) -> bool: ...


def is_AlgebraElement(x: object) -> bool: ...


def is_CommutativeAlgebraElement(x: object) -> bool: ...


def is_IntegralDomainElement(x: object) -> bool: ...


def is_DedekindDomainElement(x: object) -> bool: ...


def is_PrincipalIdealDomainElement(x: object) -> bool: ...


def is_EuclideanDomainElement(x: object) -> bool: ...


def is_InfinityElement(x: object) -> bool: ...


def is_Matrix(x: object) -> bool: ...


def is_Vector(x: object) -> bool: ...
