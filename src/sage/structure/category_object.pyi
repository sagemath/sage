from typing import Any

from sage.rings.ring import Ring
from sage.structure.sage_object import SageObject

class CategoryObject(SageObject):
    def _first_ngens(self, n) -> tuple[Any, ...]: ...

    def base_ring(self) -> Ring: ...

    def categories(self) -> list[Any]: ...

    def gens_dict(self, copy=True) -> dict[str, Any]: ...

    def gens_dict_recursive(self) -> dict[str, Any]: ...

    def inject_variables(self, scope=None, verbose=True) -> None: ...

    def latex_name(self) -> str: ...

    def latex_variable_names(self) -> list[str]: ...

    def objgen(self) -> tuple[Any, Any]: ...

    def objgens(self) -> tuple[Any, Any]: ...

    def variable_name(self) -> str: ...

    def variable_names(self) -> tuple[str, ...]: ...
