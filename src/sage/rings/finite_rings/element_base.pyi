from typing import Any

from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import CommutativeRingElement

from sage.rings.integer import Integer

class FiniteRingElement(CommutativeRingElement):
    def canonical_associate(self) -> tuple[Any, ...]: ...

    def to_bytes(self, byteorder='big') -> bytes: ...

class FinitePolyExtElement(FiniteRingElement):
    def additive_order(self) -> Integer: ...

    def is_square(self) -> bool: ...

    def minimal_polynomial(self, var='x') -> Polynomial: ...

    def minpoly(self, var='x', algorithm='pari') -> Polynomial: ...

    def multiplicative_order(self) -> Integer: ...

    def to_integer(self, reverse=False) -> int: ...
