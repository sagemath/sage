from typing import Any

from sage.rings.polynomial.polynomial_element import Polynomial

from sage.rings.finite_rings.element_base import FiniteRingElement
from sage.rings.integer import Integer
from sage.rings.ring import Field

class FiniteField(Field):
    # Provided through the category framework at runtime:
    def characteristic(self) -> Integer: ...

    def degree(self) -> Integer: ...

    def is_finite(self) -> bool: ...

    def zeta_order(self) -> Integer: ...

    def absolute_degree(self) -> Integer: ...

    def cardinality(self) -> Integer: ...

    def construction(self) -> tuple[Any, ...]: ...

    def dual_basis(self, basis=None, check=True) -> list[Any]: ...

    def embeddings(self, K) -> list[Any]: ...

    def factored_unit_order(self) -> tuple[Any, ...]: ...

    def is_conway(self) -> bool: ...

    def is_prime_field(self) -> bool: ...

    def modulus(self) -> Polynomial: ...

    def ngens(self) -> int: ...

    def order(self) -> Integer: ...

    def polynomial(self, name=None) -> Polynomial: ...

    def some_elements(self) -> list[Any]: ...

    def subfields(self, degree=0, name=None) -> list[Any]: ...

    def unit_group_exponent(self) -> Integer: ...

    def from_integer(self, n: Any, reverse: bool = False) -> FiniteRingElement: ...

    def gen(self) -> FiniteRingElement: ...

    def multiplicative_generator(self) -> FiniteRingElement: ...

    def random_element(self, *args: Any, **kwds: Any) -> FiniteRingElement: ...
