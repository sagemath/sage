import builtins
from typing import Any, Literal, overload

from sage.rings.polynomial.commutative_polynomial import CommutativePolynomial

from sage.rings.integer import Integer
from sage.structure.factorization import Factorization

class Polynomial(CommutativePolynomial):
    def adams_operator_on_roots(self, n, monic=False) -> Polynomial: ...

    def all_roots_in_interval(self, a=None, b=None) -> bool: ...

    def any_irreducible_factor(self, degree=None, assume_squarefree=False, assume_equal_deg=False, ext_degree=None) -> Polynomial: ...

    def args(self) -> tuple[Any, ...]: ...

    def base_extend(self, R) -> Polynomial: ...

    def canonical_associate(self) -> tuple[Any, ...]: ...

    def change_variable_name(self, var) -> Polynomial: ...

    def coefficients(self, sparse=True) -> builtins.list[Any]: ...

    def complex_roots(self) -> builtins.list[Any]: ...

    def compose_power(self, k, algorithm=None, monic=False) -> Polynomial: ...

    def compose_trunc(self, other, n) -> Polynomial: ...

    def composed_op(self, p1, p2, op, algorithm=None, monic=False) -> Polynomial: ...

    def cyclotomic_part(self) -> Polynomial: ...

    def degree(self, gen=None) -> Integer: ...

    def denominator(self) -> Polynomial: ...

    def dispersion(self, other=None) -> Integer: ...

    def dispersion_set(self, other=None) -> builtins.list[Any]: ...

    def divides(self, p) -> bool: ...

    def euclidean_degree(self) -> Integer: ...

    def exponents(self) -> builtins.list[int]: ...

    def factor(self, **kwargs) -> Factorization: ...

    def gradient(self) -> builtins.list[Any]: ...

    def homogenize(self, var='h') -> Polynomial: ...

    def integral(self, var=None) -> Polynomial: ...

    def inverse_mod(self, a, m) -> Polynomial: ...

    def inverse_of_unit(self) -> Polynomial: ...

    def is_constant(self) -> bool: ...

    def is_cyclotomic_product(self) -> bool: ...

    def is_gen(self) -> bool: ...

    def is_homogeneous(self) -> bool: ...

    def is_irreducible(self) -> bool: ...

    def is_lorentzian(self, explain=False) -> bool: ...

    def is_monic(self) -> bool: ...

    def is_monomial(self) -> bool: ...

    def is_nilpotent(self) -> bool: ...

    def is_primitive(self, n=None, n_prime_divs=None) -> bool: ...

    def is_real_rooted(self) -> bool: ...

    def is_squarefree(self) -> bool: ...

    def is_unit(self) -> bool: ...

    @overload
    def is_weil_polynomial(self, return_q: Literal[False] = ...) -> bool: ...

    @overload
    def is_weil_polynomial(self, return_q: Literal[True]) -> tuple[bool, Any]: ...

    def lcm(self, other) -> Polynomial: ...

    def lm(self) -> Polynomial: ...

    def lt(self) -> Polynomial: ...

    def map_coefficients(self, f, new_base_ring=None) -> Polynomial: ...

    def monic(self) -> Polynomial: ...

    def monomial_coefficients(self, copy=None) -> builtins.dict[int, Any]: ...

    def monomials(self) -> builtins.list[Any]: ...

    def multiplication_trunc(self, other, n) -> Polynomial: ...

    def newton_raphson(self, n, x0) -> builtins.list[Any]: ...

    def newton_slopes(self, p, lengths=False) -> builtins.list[Any]: ...

    def nth_root(self, n) -> Polynomial: ...

    def number_of_real_roots(self) -> int: ...

    def number_of_roots_in_interval(self, a=None, b=None) -> int: ...

    def numerator(self) -> Polynomial: ...

    def padded_list(self, n=None) -> builtins.list[Any]: ...

    def polynomial(self, var) -> Polynomial: ...

    def power_trunc(self, n, prec) -> Polynomial: ...

    def pseudo_quo_rem(self, other) -> tuple[Any, ...]: ...

    def quo_rem(self, other) -> tuple[Any, Any]: ...

    def radical(self) -> Polynomial: ...

    def rational_reconstruction(self, m, n_deg=None, d_deg=None) -> tuple[Any, ...]: ...

    def real_roots(self) -> builtins.list[Any]: ...

    def reciprocal_transform(self, R=1, q=1) -> Polynomial: ...

    def revert_series(self, n) -> Polynomial: ...

    def roots(self, ring=None, multiplicities=True, algorithm=None, **kwds) -> builtins.list[Any]: ...

    def square(self) -> Polynomial: ...

    def subresultants(self, other) -> builtins.list[Any]: ...

    def symmetric_power(self, k, monic=False) -> Polynomial: ...

    def trace_polynomial(self) -> tuple[Any, ...]: ...

    def variable_name(self) -> str: ...

    def variables(self) -> tuple[Any, ...]: ...

    def xgcd(self, other) -> tuple[Any, Any, Any]: ...
