import builtins
from typing import Any, Literal, overload

from sage.rings.real_mpfr import RealNumber
from sage.structure.element import FieldElement

from sage.rings.integer import Integer

class Rational(FieldElement):
    def absolute_norm(self) -> Rational: ...

    def as_integer_ratio(self) -> tuple[int, int]: ...

    def ceil(self) -> Integer: ...

    def conjugate(self) -> Rational: ...

    def content(self, other) -> Rational: ...

    def continued_fraction_list(self, type='std') -> builtins.list[Integer]: ...

    def denominator(self) -> Integer: ...

    def floor(self) -> Integer: ...

    def global_height(self, prec=None) -> RealNumber: ...

    def global_height_arch(self, prec=None) -> RealNumber: ...

    def global_height_non_arch(self, prec=None) -> RealNumber: ...

    def height(self) -> Integer: ...

    def imag(self) -> Rational: ...

    def is_S_integral(self, S=...) -> bool: ...

    def is_S_unit(self, S=None) -> bool: ...

    def is_integral(self) -> bool: ...

    @overload
    def is_norm(self, L, element: Literal[False] = ..., proof: bool = ...) -> bool: ...

    @overload
    def is_norm(self, L, element: Literal[True], proof: bool = ...) -> tuple[bool, Any]: ...

    def is_nth_power(self, n) -> bool: ...

    def is_one(self) -> bool: ...

    def is_padic_square(self, p, check=True) -> bool: ...

    def is_perfect_power(self, expected_value=False) -> bool: ...

    def is_rational(self) -> bool: ...

    def is_square(self) -> bool: ...

    def list(self) -> builtins.list[Rational]: ...

    def local_height(self, p, prec=None) -> RealNumber: ...

    def local_height_arch(self, p, prec=None) -> RealNumber: ...

    def mod_ui(self, n) -> int: ...

    def norm(self) -> Rational: ...

    def nth_root(self, n) -> Rational: ...

    def numerator(self) -> Integer: ...

    def period(self) -> Integer: ...

    def prime_to_S_part(self, S=...) -> Rational: ...

    def real(self) -> Rational: ...

    def relative_norm(self) -> Rational: ...

    def round(self, mode='even') -> Integer: ...

    def sign(self) -> Integer: ...

    def squarefree_part(self) -> Integer: ...

    def str(self, base=10) -> builtins.str: ...

    def support(self) -> builtins.list[Integer]: ...

    def trace(self) -> Rational: ...

    def trunc(self) -> Integer: ...

    def val_unit(self, p) -> tuple[Integer, Rational]: ...

    def valuation(self, p) -> Integer: ...
