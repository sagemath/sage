import builtins
from collections.abc import Iterator
from typing import Any

from numpy import ndarray
from sage.matrix.matrix0 import Matrix
from sage.structure.element import Vector

from sage.plot.graphics import Graphics
from sage.rings.integer import Integer
from sage.rings.ring import Ring

class FreeModuleElement(Vector):
    def Mod(self, p) -> FreeModuleElement: ...

    def additive_order(self) -> Integer: ...

    def apply_map(self, phi, R=None, sparse=None) -> FreeModuleElement: ...

    def change_ring(self, R) -> FreeModuleElement: ...

    def column(self) -> Matrix: ...

    def compositional_inverse(self, allow_multivalued_inverse=True, **kwargs) -> FreeModuleElement: ...

    def concatenate(self, other, ring=None) -> FreeModuleElement: ...

    def conjugate(self) -> FreeModuleElement: ...

    def coordinate_ring(self) -> Ring: ...

    def cross_product(self, right) -> FreeModuleElement: ...

    def cross_product_matrix(self) -> Matrix: ...

    def degree(self) -> int: ...

    def denominator(self) -> Integer: ...

    def dense_vector(self) -> FreeModuleElement: ...

    def derivative(self, *args) -> FreeModuleElement: ...

    def dict(self, copy=True) -> builtins.dict[int, Any]: ...

    def element(self) -> FreeModuleElement: ...

    def integral(self, *args, **kwds) -> FreeModuleElement: ...

    def items(self) -> Iterator[tuple[int, Any]]: ...

    def lift(self) -> FreeModuleElement: ...

    def lift_centered(self) -> FreeModuleElement: ...

    def list(self, copy=True) -> builtins.list[Any]: ...

    def list_from_positions(self, positions) -> builtins.list[Any]: ...

    def monic(self) -> FreeModuleElement: ...

    def monomial_coefficients(self, copy=True) -> builtins.dict[int, Any]: ...

    def nintegral(self, *args, **kwds) -> tuple[FreeModuleElement, Any]: ...

    def nonzero_positions(self) -> builtins.list[int]: ...

    def normalized(self, p='__two__') -> FreeModuleElement: ...

    def numerical_approx(self, prec=None, digits=None, algorithm=None) -> FreeModuleElement: ...

    def numpy(self, dtype='object') -> ndarray: ...

    def outer_product(self, right) -> Matrix: ...

    def pairwise_product(self, right) -> FreeModuleElement: ...

    def plot_step(self, xmin=0, xmax=1, eps=None, res=None, connect=True, **kwds) -> Graphics: ...

    def row(self) -> Matrix: ...

    def set(self, i, value) -> None: ...

    def sparse_vector(self) -> FreeModuleElement: ...

    def subs(self, in_dict=None, **kwds) -> FreeModuleElement: ...

    def support(self) -> builtins.list[int]: ...


def vector(arg0, arg1=None, arg2=None, sparse=None, immutable=False) -> FreeModuleElement: ...
