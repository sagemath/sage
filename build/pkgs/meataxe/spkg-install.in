# Directory where executables are installed.
export MTXBIN="$SAGE_LOCAL"/bin

# Field size up to GF(256)
export ZZZ=0

cd src
# Generate and install all multiplication tables, including GF(256).
sdh_configure --enable-tables --with-mtxlib="${MTXLIB:-$SAGE_SHARE/meataxe}"
sdh_make
sdh_make_install

if [ "$SAGE_SPKG_INSTALL_DOCS" = yes ] ; then
    $MAKE doc || sdh_die "Error documenting SharedMeatAxe"
fi
