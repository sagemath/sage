CFLAGS="$CFLAGS -I$SAGE_LOCAL/include -g"
CFLAGS="$CFLAGS -fPIC -Wall -pedantic"

if [ "x$SAGE_DEBUG" = "xyes" ]; then
   ENABLE_DEBUG="--enable-debug"
else
   ENABLE_DEBUG=""
fi

export CFLAGS

if [ "x$SAGE_FAT_BINARY" = "xyes" ]; then
    DISABLE_SSE2="--disable-sse2"
else
    DISABLE_SSE2=""
fi

cd src

cp "$SAGE_ROOT"/config/config.* .

# Reuse Sage's OpenMP detection: M4RI's AX_OPENMP splits multi-word flags.
if [ -n "$OPENMP_CFLAGS" ]; then
    export ax_cv_c_openmp="$OPENMP_CFLAGS $OPENMP_CLIB"
fi
# Configure and build M4RI
sdh_configure --enable-openmp --enable-shared --disable-static $ENABLE_DEBUG $DISABLE_SSE2
sdh_make
sdh_make_install
